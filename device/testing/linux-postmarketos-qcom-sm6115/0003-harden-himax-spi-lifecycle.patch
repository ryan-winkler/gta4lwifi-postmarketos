 	spin_lock_irqsave(&ts->irq_lock, irqflags);
@@ -578,34 +606,38 @@
 int himax_gpio_power_config(struct himax_i2c_platform_data *pdata)
 {
-	int error = 0;
+	int error, irq;
+
+	private_ts->hx_irq = 0;
+	if (!pdata->gpio_irq || !pdata->gpio_reset)
+		return -ENODEV;
 
 #if defined(HX_RST_PIN_FUNC)
-	if (pdata->gpio_reset)
-		gpiod_direction_output(pdata->gpio_reset, 0);
+	error = gpiod_direction_output(pdata->gpio_reset, 0);
+	if (error)
+		return error;
 #endif
 
 	if (pdata->gpio_3v3_en) {
-		gpiod_direction_output(pdata->gpio_3v3_en, 1);
-		I("3v3_en set 1 get pin = %d\n",
-			gpiod_get_value(pdata->gpio_3v3_en));
+		error = gpiod_direction_output(pdata->gpio_3v3_en, 1);
+		if (error)
+			return error;
 	}
 
-	if (pdata->gpio_irq) {
-		gpiod_direction_input(pdata->gpio_irq);
-		private_ts->hx_irq = gpiod_to_irq(pdata->gpio_irq);
-	} else {
-		E("irq gpio not provided\n");
-		return -ENODEV;
-	}
+	error = gpiod_direction_input(pdata->gpio_irq);
+	if (error)
+		return error;
+	irq = gpiod_to_irq(pdata->gpio_irq);
+	if (irq <= 0)
+		return irq ? irq : -EINVAL;
 
 	usleep_range(2000, 2001);
-
 #if defined(HX_RST_PIN_FUNC)
-	if (pdata->gpio_reset)
-		gpiod_direction_output(pdata->gpio_reset, 1);
+	error = gpiod_direction_output(pdata->gpio_reset, 1);
+	if (error)
+		return error;
 #endif
-
-	return error;
+	private_ts->hx_irq = irq;
+	return 0;
 }
 
 #endif
@@ -654,3 +686,3 @@
-			IRQF_TRIGGER_FALLING | IRQF_ONESHOT,
