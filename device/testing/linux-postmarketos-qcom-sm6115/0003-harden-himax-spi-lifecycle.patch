 		pdata->gpio_3v3_en = NULL;
 	}
 
@@ -285,37 +286,53 @@
 static int himax_spi_read(uint8_t *command, uint8_t command_len,
 		uint8_t *data, uint32_t length, uint8_t toRetry)
 {
+	struct spi_device *sdev = private_ts->spi;
 	struct spi_message message;
-	struct spi_transfer xfer[2];
-	int retry;
-	int error;
+	struct spi_transfer xfer[2] = { };
+	u8 *tx, *rx;
+	size_t max_message = spi_max_message_size(sdev);
+	int retry, error = -EIO;
+
+	if (!command || !data || !command_len || !length || !toRetry)
+		return -EINVAL;
+	if (length > HX_MAX_WRITE_SZ ||
+	    command_len > spi_max_transfer_size(sdev) ||
+	    length > spi_max_transfer_size(sdev) ||
+	    command_len > max_message || length > max_message - command_len)
+		return -EMSGSIZE;
+
+	/* Callers include stack-backed register buffers: DMA sees only these. */
+	tx = kmemdup(command, command_len, GFP_KERNEL);
+	if (!tx)
+		return -ENOMEM;
+	rx = kmalloc(length, GFP_KERNEL);
+	if (!rx) {
+		kfree(tx);
+		return -ENOMEM;
+	}
 
 	spi_message_init(&message);
-	memset(xfer, 0, sizeof(xfer));
-
-	xfer[0].tx_buf = command;
+	xfer[0].tx_buf = tx;
 	xfer[0].len = command_len;
 	spi_message_add_tail(&xfer[0], &message);
-
-	xfer[1].rx_buf = data;
+	xfer[1].rx_buf = rx;
 	xfer[1].len = length;
 	spi_message_add_tail(&xfer[1], &message);
 
+	/* One message keeps CS asserted between the command and response. */
 	for (retry = 0; retry < toRetry; retry++) {
-		error = spi_sync(private_ts->spi, &message);
-		if (unlikely(error))
-			E("SPI read error: %d\n", error);
-		else
+		error = spi_sync(sdev, &message);
+		if (!error && message.actual_length != command_len + length)
+			error = -EIO;
+		if (!error) {
+			memcpy(data, rx, length);
 			break;
+		}
 	}
 
-	if (retry == toRetry) {
-		E("%s: SPI read error retry over %d\n",
-			__func__, toRetry);
-		return -EIO;
-	}
-
-	return 0;
+	kfree(rx);
+	kfree(tx);
+	return error;
 }
 
 static int himax_spi_write(uint8_t *buf, uint32_t length)
@@ -366,6 +383,13 @@
 	int i = 0;
 	int result = 0;
 
+	if (!spi_format_buf || (length && !data) || !toRetry)
