From: gta4lwifi maintainers
Subject: [PATCH] input: himax: repair PM, probe, transport and teardown contracts

Follow-up to the Samsung SPI import. This repairs source-level defects;
it does not assert working hardware or implement native panel integration.

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1417,5 +1417,5 @@
 config TOUCHSCREEN_HIMAX_CHIPSET
 	bool "Himax touchpanel CHIPSET"
-	depends on I2C
+	depends on SPI_MASTER
 	help
 	  Say Y here if you have a Himax CHIPSET touchscreen.
diff --git a/drivers/input/touchscreen/hxchipset/Kconfig b/drivers/input/touchscreen/hxchipset/Kconfig
--- a/drivers/input/touchscreen/hxchipset/Kconfig
+++ b/drivers/input/touchscreen/hxchipset/Kconfig
@@ -5,7 +5,7 @@
 config TOUCHSCREEN_HIMAX_COMMON
-        tristate "HIMAX chipset i2c touchscreen"
+        tristate "HIMAX chipset SPI touchscreen"
 		depends on TOUCHSCREEN_HIMAX_CHIPSET
 		help
-		This enables support for HIMAX CHIPSET over I2C based touchscreens.
+		This enables support for HIMAX CHIPSET over SPI based touchscreens.
 
 choice
diff --git a/drivers/input/touchscreen/hxchipset/himax_common.c b/drivers/input/touchscreen/hxchipset/himax_common.c
--- a/drivers/input/touchscreen/hxchipset/himax_common.c
+++ b/drivers/input/touchscreen/hxchipset/himax_common.c
@@ -744,3 +744,23 @@
 EXPORT_SYMBOL(himax_parse_assign_cmd);
 
+static void himax_release_input(struct himax_ts_data *ts)
+{
+	if (ts->hx_pen_dev) {
+		if (ts->pen_registered)
+			input_unregister_device(ts->hx_pen_dev);
+		else
+			input_free_device(ts->hx_pen_dev);
+		ts->hx_pen_dev = NULL;
+		ts->pen_registered = false;
+	}
+	if (ts->input_dev) {
+		if (ts->input_registered)
+			input_unregister_device(ts->input_dev);
+		else
+			input_free_device(ts->input_dev);
+		ts->input_dev = NULL;
+		ts->input_registered = false;
+	}
+}
+
 int himax_input_register(struct himax_ts_data *ts)
@@ -790,3 +810,4 @@
 	if (himax_input_register_device(ts->input_dev) == 0) {
+		ts->input_registered = true;
 		ret = NO_ERR;
 	} else {
@@ -838,3 +859,4 @@
 	if (himax_input_register_device(ts->hx_pen_dev) == 0) {
+		ts->pen_registered = true;
 		ret = NO_ERR;
 	} else {
@@ -2800,10 +2822,13 @@
-	if (himax_parse_dt(ts, pdata) < 0) {
-		I(" pdata is NULL for DT\n");
+	err = himax_parse_dt(ts, pdata);
+	if (err)
 		goto err_alloc_dt_pdata_failed;
-	}
 
 #if defined(HX_RST_PIN_FUNC)
 	ts->rst_gpio = pdata->gpio_reset;
 #endif
-	himax_gpio_power_config(pdata);
+	err = himax_gpio_power_config(pdata);
+	if (err)
+		goto err_alloc_dt_pdata_failed;
+	/* Later vendor detection branches must not return a stale success. */
+	err = -ENODEV;
 #if !defined(CONFIG_OF)
@@ -2870,6 +2895,4 @@
 	INIT_DELAYED_WORK(&ts->work_boot_upgrade, himax_boot_upgrade);
-	queue_delayed_work(ts->himax_boot_upgrade_wq, &ts->work_boot_upgrade,
-			msecs_to_jiffies(2000));
 #endif
 
 #if defined(HX_CONTAINER_SPEED_UP)
@@ -2880,4 +2903,5 @@
 	if (!ts->ts_int_workqueue) {
 		E("%s: create ts_resume workqueue failed\n", __func__);
+		err = -ENOMEM;
 		goto err_create_ts_resume_wq_failed;
 	}
@@ -2930,6 +2954,6 @@
 	if (ret) {
-		E("%s: Unable to register %s input device\n",
-			__func__, ts->input_dev->name);
+		E("%s: Unable to register input device: %d\n", __func__, ret);
+		err = ret;
 		goto err_input_register_device_failed;
 	}
 
@@ -2980,8 +3004,13 @@
-	if (himax_common_proc_init()) {
+	err = himax_common_proc_init();
+	if (err) {
 		E(" %s: himax_common proc_init failed!\n", __func__);
 		goto err_creat_proc_file_failed;
 	}
 
-	himax_ts_register_interrupt();
+	err = himax_ts_register_interrupt();
+	if (err) {
+		himax_common_proc_deinit();
+		goto err_creat_proc_file_failed;
+	}
 
 #if defined(CONFIG_TOUCHSCREEN_HIMAX_DEBUG)
@@ -2995,8 +3024,14 @@
 #if defined(HX_BOOT_UPGRADE) || defined(HX_ZERO_FLASH)
-	if (g_boot_upgrade_flag)
-		himax_int_enable(0);
+	if (!g_boot_upgrade_flag)
+		himax_int_enable(1);
+#else
+	himax_int_enable(1);
 #endif
 	g_hx_chip_inited = true;
+#if defined(HX_BOOT_UPGRADE) || defined(HX_ZERO_FLASH)
+	queue_delayed_work(ts->himax_boot_upgrade_wq, &ts->work_boot_upgrade,
+			msecs_to_jiffies(2000));
+#endif
 	return 0;
 
 err_creat_proc_file_failed:
@@ -3015,3 +3050,3 @@
 err_input_register_device_failed:
-	input_free_device(ts->input_dev);
+	himax_release_input(ts);
 /*err_detect_failed:*/
@@ -3071,6 +3106,15 @@
 {
 	struct himax_ts_data *ts = private_ts;
 
+	WRITE_ONCE(ts->stopping, true);
+	himax_common_proc_deinit();
+#if defined(HX_CONTAINER_SPEED_UP)
+	cancel_delayed_work_sync(&ts->ts_int_work);
+#endif
+#if defined(HX_BOOT_UPGRADE) || defined(HX_ZERO_FLASH)
+	cancel_delayed_work_sync(&ts->work_boot_upgrade);
+#endif
 	himax_ts_unregister_interrupt();
+	ts->initialized = false;
 
 #if defined(CONFIG_TOUCHSCREEN_HIMAX_INSPECT)
@@ -3087,4 +3131,3 @@
-	himax_common_proc_deinit();
 	himax_report_data_deinit();
 
 #if defined(HX_SMART_WAKEUP)
@@ -3114,3 +3157,3 @@
 #endif
-	input_free_device(ts->input_dev);
+	himax_release_input(ts);
 #if defined(HX_CONTAINER_SPEED_UP)
@@ -3148,5 +3191,4 @@
 	kfree(ts->pdata);
 	ts->pdata = NULL;
-	kfree(ts);
-	ts = NULL;
+	g_hx_chip_inited = false;
 	probe_fail_flag = 0;
@@ -3280,4 +3322,6 @@
 		if (result) {
 			E("Something wrong! Skip Update zero flash!\n");
-			goto ESCAPE_0F_UPDATE;
+			ts->suspended = true;
+			atomic_set(&ts->suspend_mode, 1);
+			return result < 0 ? result : -EIO;
 		}
@@ -3330,5 +3374,2 @@
 	himax_int_enable(1);
-#if defined(HX_ZERO_FLASH) && defined(HX_RESUME_SET_FW)
-ESCAPE_0F_UPDATE:
-#endif
 END:
diff --git a/drivers/input/touchscreen/hxchipset/himax_common.h b/drivers/input/touchscreen/hxchipset/himax_common.h
