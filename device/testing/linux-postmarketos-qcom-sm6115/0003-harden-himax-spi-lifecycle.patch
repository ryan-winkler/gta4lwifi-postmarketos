-	int ret = 0;
+	int ret;
 
+	ts->use_irq = 0;
 	ts->irq_enabled = 0;
+	atomic_set(&ts->irq_state, 0);
+	if (ts->hx_irq <= 0)
+		return -EINVAL;
 
