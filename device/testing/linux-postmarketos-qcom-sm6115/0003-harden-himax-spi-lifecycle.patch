-			I("%s: irq enabled at gpio: %d\n", __func__,
-				private_ts->hx_irq);
+	ret = himax_int_register_trigger();
+	if (ret)
+		return ret;
+	ts->use_irq = 1;
+	/* IRQF_NO_AUTOEN keeps input quiet until firmware is ready. */
 #if defined(HX_SMART_WAKEUP)
-			irq_set_irq_wake(private_ts->hx_irq, 1);
+	irq_set_irq_wake(ts->hx_irq, 1);
 #endif
