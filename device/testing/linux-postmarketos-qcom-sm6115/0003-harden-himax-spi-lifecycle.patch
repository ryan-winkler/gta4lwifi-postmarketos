 			HIMAX_common_NAME, ts);
 	} else {
@@ -659,4 +691,5 @@
-			IRQF_TRIGGER_LOW | IRQF_ONESHOT, HIMAX_common_NAME, ts);
+			IRQF_TRIGGER_LOW | IRQF_ONESHOT | IRQF_NO_AUTOEN,
+			HIMAX_common_NAME, ts);
 	}
 
 	return ret;
@@ -674,44 +707,23 @@
 int himax_ts_register_interrupt(void)
 {
 	struct himax_ts_data *ts = private_ts;
