 	pdata->gpio_reset = devm_fwnode_gpiod_get_index(ts->dev,
 			of_fwnode_handle(dt), "himax,rst", 0, GPIOD_ASIS, "himax_reset");
-	if (IS_ERR(pdata->gpio_reset)) {
-		I(" DT:gpio_rst value is not valid\n");
-		pdata->gpio_reset = NULL;
-	}
+	if (IS_ERR(pdata->gpio_reset))
+		return dev_err_probe(ts->dev, PTR_ERR(pdata->gpio_reset),
+				     "failed to acquire touch reset GPIO\n");
 
 	pdata->gpio_3v3_en = devm_fwnode_gpiod_get_index(ts->dev,
 			of_fwnode_handle(dt), "himax,3v3", 0, GPIOD_ASIS, "himax_3v3_en");
 	if (IS_ERR(pdata->gpio_3v3_en)) {
-		I(" DT:gpio_3v3_en value is not valid\n");
+		/* Only an absent optional supply GPIO is acceptable. */
