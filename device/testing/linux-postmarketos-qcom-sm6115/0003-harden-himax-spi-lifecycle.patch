+	    length + 2 > spi_max_message_size(private_ts->spi))
+		return -EMSGSIZE;
+
 	mutex_lock(&(private_ts->rw_lock));
 	spi_format_buf[0] = 0xF2;
 	spi_format_buf[1] = command;
@@ -399,3 +423,7 @@
 	int irqnum = ts->hx_irq;
 
